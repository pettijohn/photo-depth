{
  "name": "photo-depth-bokeh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:static": "playwright test --config playwright.static.config.ts",
    "build": "bun run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/bun": "^1.2.0",
    "@types/node": "^26.4.0",
    "jsdom": "^30.0.1",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
